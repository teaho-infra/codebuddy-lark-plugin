# Lark/Feishu bot credentials (required)
# For multiple CodeBuddy instances, prefer ~/.codebuddy/lark-channel.json;
# when that file exists, its selected bot profile takes precedence over these
# legacy single-bot environment values.
# Create a self-built app at https://open.feishu.cn (or https://open.larksuite.com)
# Add the "机器人 (bot)" capability and enable these event subscriptions (long connection mode):
#   im.message.receive_v1
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API domain:
#   Feishu (China):  https://open.feishu.cn   (default)
#   Lark (global):   https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# Sender allowlist (recommended). Comma-separated open_id values.
# Tip: leave empty on first run, DM the bot once, and copy the open_id from the logs.
LARK_ALLOWED_SENDERS=

# Accept messages from anyone (DANGEROUS — prompt-injection risk). Testing only.
LARK_ALLOW_ALL=false

# Also forward messages from group chats the bot is in (sender allowlist still applies).
LARK_GROUP_CHAT_ENABLED=false

# Download images from image messages and pass local file paths to CodeBuddy.
LARK_IMAGE_DOWNLOAD=true

# Where to cache downloaded media.
LARK_MEDIA_DIR=./.lark-media

# ----------------------------------------------------------------------------
# Corporate proxy (optional)
# ----------------------------------------------------------------------------
# LARK_PROXY is the recommended single switch: full URL or bare host:port.
# When set, the plugin routes SDK HTTP requests (axios) via HTTPS_PROXY,
# routes the WebSocket long-connection through an https-proxy-agent, and sets
# NODE_TLS_REJECT_UNAUTHORIZED=0 (corp MITM proxies use private CAs — only
# enable on networks you trust). An empty value disables the proxy entirely.
# It can also be set per-bot as "proxy" in lark-channel.json, or as the
# plugin option "proxy" in settings.json pluginConfigs.
#   LARK_PROXY=http://proxy-intlho.wal-mart.com:8080
LARK_PROXY=

# Alternatively, the standard env vars below are honored when LARK_PROXY is
# unset. lower-case names match Node's HTTPS agent convention; UPPER-CASE
# matches curl/git. They are read by the underlying SDK / axios at request
# time.
#
# Example (replace with your corporate proxy):
#   HTTP_PROXY=http://proxy.corp.example.com:8080
#   HTTPS_PROXY=http://proxy.corp.example.com:8080
#   NO_PROXY=localhost,127.0.0.1,.corp.example.com
#
# If your proxy performs TLS interception with a private CA, Node will refuse
# the cert chain. Set NODE_TLS_REJECT_UNAUTHORIZED=0 ONLY if you trust the
# proxy operator (e.g. your own corporate MITM appliance). Never set this in
# untrusted environments. LARK_PROXY already sets it automatically.
#   NODE_TLS_REJECT_UNAUTHORIZED=0
#
# The plugin searches for this .env in these locations (first hit wins):
#   1. <cwd>/.env                              (workspace-level)
#   2. <cwd>/../.env
#   3. <plugin bundle>/../.env                 (next to dist/)
#   4. ~/.codebuddy/.env                       (CodeBuddy user config)
#   5. ~/.codebuddy/plugins/data/codebuddy-lark-channel/.env
#
# Tip: when debugging, the plugin logs which .env it loaded and how many vars
# it picked up — search stderr for "loaded N var(s) from <path>".
