# Lark/Feishu bot credentials (required)
# Create a self-built app at https://open.feishu.cn (or https://open.larksuite.com)
# Add the "机器人 (bot)" capability and enable these event subscriptions (long connection mode):
#   im.message.receive_v1
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API domain:
#   Feishu (China):  https://open.feishu.cn   (default)
#   Lark (global):   https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# Sender allowlist (recommended). Comma-separated open_id values.
# Tip: leave empty on first run, DM the bot once, and copy the open_id from the logs.
LARK_ALLOWED_SENDERS=

# Accept messages from anyone (DANGEROUS — prompt-injection risk). Testing only.
LARK_ALLOW_ALL=false

# Also forward messages from group chats the bot is in (sender allowlist still applies).
LARK_GROUP_CHAT_ENABLED=false

# Download images from image messages and pass local file paths to CodeBuddy.
LARK_IMAGE_DOWNLOAD=true

# Where to cache downloaded media.
LARK_MEDIA_DIR=./.lark-media
