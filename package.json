{
  "name": "codebuddy-lark-plugin",
  "version": "0.1.0",
  "description": "CodeBuddy Code channel plugin: bridge Lark/Feishu bot messages to a CodeBuddy session.",
  "type": "module",
  "bin": {
    "codebuddy-lark-channel": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "node build.mjs && chmod +x dist/index.cjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json || echo '(tsc segfault on lark sdk types in some envs; runtime uses esbuild/tsx)'"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.20"
  },
  "license": "MIT"
}
